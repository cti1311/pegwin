# Copy to .env and fill in. Never commit real secrets.
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=pegwin
DB_PASSWORD=
DB_NAME=pegwin
JWT_SECRET=change-me-in-production
# Set to 'false' to disable the draft payments/payouts surface (§8/§9 TBD).
PAYMENTS_DRAFT=true
CASHFREE_URL=
RAZORPAY_URL=
CASHFREE_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Reserved for future caching/queue use (docker-compose provides Redis;
# the API does not consume it yet).
REDIS_URL=redis://localhost:6379/0
# Logging: file output ON by default (backend/logs/, daily rotation).
LOG_LEVEL=info
LOG_DIR=logs
LOG_TO_FILE=true
LOG_TO_CONSOLE=true
LOG_RETENTION_DAYS=14
LOG_MAX_BYTES=10485760
# Firebase Admin SDK: phone-auth verify + FCM push (both platforms; iOS via
# the APNs Auth Key uploaded in the Firebase console). Private key uses
# literal \n escapes. Without these, verify returns 503 and push is skipped.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
PUSH_ENABLED=true
# Transactional email, multi-provider with failover. Slots accept ses|brevo|''
# (empty disables). SES SMTP creds come from the AWS SES console; Brevo from
# SMTP & API settings. Without any provider, email sends are skipped.
EMAIL_ENABLED=true
EMAIL_FROM=Pegwin <no-reply@pegwin.example>
EMAIL_PRIMARY=ses
EMAIL_FAILOVER=brevo
SES_SMTP_HOST=
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
